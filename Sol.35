class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        if not len(nums):
            return
        if target in nums:
            return nums.index(target)
        else:
            n=0
            for i in range(len(nums)):
                if (nums[i]>target) and ( i<len(nums)):
                    return i
                elif(i+1==len(nums)):
                    return len(nums)

