class Solution:
    def lengthOfLastWord(self, s: str) -> int:
          return len(s.strip().split()[-1])
          # strip() removes spaces from the start and end of the string
        # Example: "   Hello World   " -> "Hello World"
        
        # split() breaks the string into a list of words using spaces
        # Example: "Hello World" -> ["Hello", "World"]
        
        # [-1] gets the last word from the list
        # Example: ["Hello", "World"][-1] -> "World"
        
        # len() counts the number of characters in that last word
        # Example: len("World") -> 5
        
