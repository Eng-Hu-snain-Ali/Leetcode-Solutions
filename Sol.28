class Solution:
    def strStr(self, haystack: str, needle: str) -> int:
         if needle == "":
            return 0  # Empty string case
         n, m = len(haystack), len(needle)
         for i in range(n - m + 1):  # only need to go until haystack can fit needle
            if haystack[i:i+m] == needle:
                return i
         return -1

            
