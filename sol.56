class Solution:
    def merge(self, intervals: List[List[int]]) -> List[List[int]]:
        i=0
        intervals.sort(key =lambda x:x[0])
        while(i<len(intervals)):
        
            end=intervals[i][1]
            j=i+1
            while j<len(intervals):
                if intervals[j][0]<=end:
                    intervals[i][1]= max(intervals[j][1],end)
                    intervals.pop(j)
                    end=intervals[i][1]
                else: j=j+1
            i=i+1
        return intervals
