class Solution:
    def reverse(self, x: int) -> int:
    

      num=x
      if(x<0):
        num=num*-1
      
      result=0
      while(num>1 or num==1):
        result=result*10+(num%10)
        num=int(num/10)
      if(x<0):
        result=result*-1
      if not (-2**31 <= result <= 2**31 - 1):
        return 0
      return result
         
